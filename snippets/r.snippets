

snippet ass "assign"
	%>% 
	{ . } -> ${1}


snippet b "browser"
	browser()


snippet xc "copy to clipboard"
	%>% clipr::write_clip()

snippet ad "across Date"
	mutate( across( ends_with('Date'), as.Date )) %>%

